{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Desktop Client",
  "version": "0.1.0",
  "identifier": "com.lulzsec6824.mydesktopapp",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "POS Desktop Client",
        "width": 1360,
        "height": 860,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
